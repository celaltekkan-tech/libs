# --- Veritabanı ---
DB_USER=postgres
DB_PASS=your_password
DB_NAME=lise_idari_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Docker Compose (production) ---
# docker-compose.yml içindeki backend/db servisleri bu dosyayı (.env) kullanır.
# DB_HOST otomatik olarak "db" servisine yönlendirilir, burada değiştirmenize gerek yok.
#
# NPM_NETWORK_NAME: Nginx Proxy Manager'ın çalıştığı Docker network adı.
# `docker network ls` ile bulup buraya yazın (frontend container'ı bu network'e katılır,
# NPM proxy host hedefi olarak "frontend" container adını kullanır).
NPM_NETWORK_NAME=npm_default
#
# VITE_API_URL: Boş bırakılırsa frontend, API isteklerini kendi domaini üzerinden
# (nginx proxy_pass ile backend container'ına) gönderir - önerilen kurulum budur.
# Sadece API'yi ayrı bir subdomain'de (örn. api.example.com) yayınlıyorsanız doldurun.
VITE_API_URL=

# --- Uygulama ---
NODE_ENV=development
PORT=4000
# Tüm ağ arayüzlerinde dinle (LAN erişimi için). Sadece localhost: 127.0.0.1
HOST=0.0.0.0

# --- Kimlik doğrulama ---
# Production ortamında zorunludur, uzun ve rastgele bir değer kullanın.
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=8h

# Herkese açık kayıt ucu. Kullanıcılar okul yönetimi tarafından oluşturulacaksa
# false bırakın (varsayılan davranış).
ALLOW_PUBLIC_REGISTER=false

# --- Frontend ---
# Birden fazla adres virgülle ayrılarak yazılabilir.
# Geliştirmede (NODE_ENV!=production) yerel ağ IP'leri (192.168.x / 10.x / 172.16-31.x)
# otomatik kabul edilir; production'da yalnızca bu liste geçerlidir.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Demo veri (npm run seed) ---
DEMO_ADMIN_EMAIL=admin@okul.local
DEMO_ADMIN_PASSWORD=Admin1234

# --- Platform yöneticisi (npm run seed) ---
# Tenant'lar üstü hesap yönetimi (/api/tenants) için ilk platform admin hesabı.
PLATFORM_ADMIN_EMAIL=superadmin@lise-idari.local
PLATFORM_ADMIN_PASSWORD=SuperAdmin1234

# --- SMS motoru (src/services/smsEngine.js) ---
# 'external_cli' (yerel bir programı parametreyle çalıştırır) veya 'http_api'
# (genel bir toplu SMS HTTP servisine istek atar).
SMS_PROVIDER=external_cli

# external_cli sağlayıcısı:
# Çalıştırılabilir programın tam yolu. Program stdout'a tek satır JSON
# döndürmelidir: {"success": true, "messageId": "..."} veya {"success": false, "error": "..."}
SMS_EXTERNAL_PROGRAM_PATH=
# Argüman şablonu (JSON dizisi). {phone} ve {message} yer tutucuları
# gönderim anında doldurulur. Boş bırakılırsa program [telefon, mesaj] ile çağrılır.
# Örn: SMS_EXTERNAL_PROGRAM_ARGS=["--to","{phone}","--text","{message}"]
SMS_EXTERNAL_PROGRAM_ARGS=
SMS_EXTERNAL_PROGRAM_TIMEOUT_MS=15000

# http_api sağlayıcısı (toplu SMS firması netleşince doldurulur):
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_API_KEY=
SMS_HTTP_API_KEY_HEADER=Authorization
# Yanıt gövdesinde başarıyı belirten alan adı (örn. "success"). Boşsa yalnızca
# HTTP 2xx durum kodu başarı sayılır.
SMS_HTTP_SUCCESS_FIELD=
SMS_HTTP_MESSAGE_ID_FIELD=messageId
SMS_HTTP_ERROR_FIELD=error
SMS_HTTP_TIMEOUT_MS=15000
