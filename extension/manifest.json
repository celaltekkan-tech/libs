{
  "manifest_version": 3,
  "name": "OIDS e-Okul Ders Programı",
  "version": "1.0.0",
  "description": "OIDS ders programını e-Okul ders programı ekranına işler. MEBBİS oturumunu kullanır, şifre istemez.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OIDS ders programı"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "webNavigation"],
  "host_permissions": [
    "https://uyg.oids.com.tr/*",
    "https://api.oids.com.tr/*",
    "https://e-okul.meb.gov.tr/*",
    "https://mebbis.meb.gov.tr/*",
    "https://*.meb.gov.tr/*"
  ],
  "externally_connectable": {
    "matches": ["https://uyg.oids.com.tr/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://e-okul.meb.gov.tr/*", "https://*.meb.gov.tr/*"],
      "js": ["content/eokul.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://uyg.oids.com.tr/*"],
      "js": ["content/oids.js"],
      "run_at": "document_idle"
    }
  ]
}
